{
  "name": "vscode-mcp-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "testsprite": "node src/tool.js testsprite",
    "playwright": "node src/tool.js playwright",
    "insforge": "node src/tool.js insforge",
    "stitch": "node src/tool.js stitch",
    "validate:test-report": "node scripts/validate_test_report.js",
    "test:preflight": "tsx tests/preflight.ts",
    "test:preflight:ps1": "pwsh -File scripts/test-preflight.ps1",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:property": "vitest run tests/property",
    "test:e2e": "playwright test",
    "test:all": "npm run test:preflight && npm run test:unit && npm run test:contracts && npm run test:property",
    "key:generate": "tsx core/keyManager.ts generate",
    "key:fingerprint": "tsx core/keyManager.ts fingerprint",
    "snap:create": "tsx core/snapshotManager.ts create boot",
    "snap:list": "tsx core/snapshotManager.ts list",
    "integrity:generate": "tsx core/integrityVerifier.ts generate",
    "integrity:verify": "tsx core/integrityVerifier.ts verify",
    "ui:patch:apply": "tsx scripts/ui-patch-apply.ts",
    "ui:patch:revert": "tsx scripts/ui-patch-revert.ts",
    "quarantine:list": "tsx core/quarantineManager.ts list",
    "boot:safe": "tsx core/safeBoot.ts",
    "patchlog:list": "tsx core/guards/patchlog.ts list",
    "patchlog:stats": "tsx core/guards/patchlog.ts stats",
    "guardian:start": "tsx guardian/guardian-service.ts",
    "guardian:test": "tsx guardian/securityTests.ts",
    "guardian:init": "tsx guardian/guardian-service.ts --init-only",
    "vault:init": "node -e \"import('./guardian/creatorKeyManager.ts').then(m => { m.initializeVault(process.env.CREATOR_PIN, process.env.CREATOR_KEY); console.log('Vault initialized.'); })\"",
    "deploy:cloudflare": "echo 'Use /api/deployment/cloudflare endpoint'",
    "learn:fetch": "python scripts/fetch_dev_trends.py",
    "learn:schedule": "schtasks /create /tn AgentLeeLearning /tr \"py %CD%\\scripts\\fetch_dev_trends.py\" /sc daily /st 02:00 /f",
    "learn:run-now": "npm run learn:fetch",
    "knowledge:view": "node -e \"const f=require('fs');const d=JSON.parse(f.readFileSync('workspace/knowledge/dev_trends.json'));console.log(JSON.stringify(d.summary,null,2));\""
  },
  "dependencies": {
    "@insforge/mcp": "^1.2.6",
    "@playwright/mcp": "^0.0.68",
    "@testsprite/testsprite-mcp": "^0.0.26",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pm2": "^6.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^3.23.2",
    "puppeteer": "^24.37.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
