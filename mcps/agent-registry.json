{
  "$schema": "./schemas/agent-registry.schema.json",
  "version": "1.0.0",
  "agents": [
    {
      "id": "planner-agent-mcp",
      "name": "PlannerAgent",
      "mission": "Decompose intents into ordered plans and assign steps to agents.",
      "layer": "backbone",
      "tools": [
        "make_plan",
        "break_into_steps",
        "choose_agent",
        "suggest_recovery",
        "summarize_mission"
      ],
      "inputs": ["ContextPacket"],
      "outputs": ["PlanStep[]", "MissionSummary"],
      "authority_boundaries": "Plan and delegate only. No execution, no file I/O.",
      "model_lane": "glm_flash",
      "fallback_model_lane": "qwen_local",
      "deployment_location": "cerebral",
      "transport": "stdio",
      "runtime": "node",
      "port": null,
      "fallback_behavior": "Fall back to qwen_local if glm_flash unavailable.",
      "health_check": "make_plan",
      "memory_scope": "mission",
      "auth_allowed": ["zai_key"],
      "escalation_rules": [
        "If make_plan returns empty, escalate to agent-lee-core",
        "If recovery fails twice, abort and escalate"
      ],
      "status": "unknown",
      "last_seen": null,
      "basic_task_status": "unknown",
      "complex_task_status": "unknown",
      "last_tested_at": null,
      "confidence_score": 0
    },
    {
      "id": "memory-agent-mcp",
      "name": "MemoryAgent",
      "mission": "Three-layer memory management: session (in-memory) → InsForge cache (7-day) → NotebookLM deep recall.",
      "layer": "backbone",
      "tools": [
        "recall_context",
        "append_session",
        "compress_session",
        "build_context_packet",
        "write_summary",
        "fetch_related_episodes"
      ],
      "inputs": ["session_id", "utterance", "intent", "messages[]"],
      "outputs": ["ContextPacket", "MemorySnapshot", "MissionSummary"],
      "authority_boundaries": "Read/write memory only. No code execution.",
      "model_lane": "notebooklm",
      "fallback_model_lane": "glm_flash",
      "deployment_location": "vercel",
      "transport": "stdio",
      "runtime": "node",
      "port": null,
      "fallback_behavior": "If NotebookLM offline, fall back to GLM-Flash. If Vercel offline, cache locally.",
      "health_check": "recall_context",
      "memory_scope": "canonical",
      "auth_allowed": ["gemini_key", "vercel_db"],
      "escalation_rules": [
        "If recall_context empty 3 turns, warn agent-lee-core",
        "If write_summary fails, queue to data/memory_cache.jsonl"
      ],
      "status": "unknown",
      "last_seen": null,
      "basic_task_status": "unknown",
      "complex_task_status": "unknown",
      "last_tested_at": null,
      "confidence_score": 0
    },
